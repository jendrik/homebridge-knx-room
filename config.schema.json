{
  "pluginAlias": "knx-room",
  "pluginType": "platform",
  "singular": true,
  "schema": {
    "type": "object",
    "properties": {
      "ip": {
        "title": "KNX Router or Interface",
        "type": "string",
        "default": "224.0.23.12",
        "minLength": 1,
        "placeholder": "224.0.23.12",
        "pattern": "^(?:[0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])\\.(?:[0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])\\.(?:[0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])\\.(?:[0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])$",
        "description": "IPv4 address of the KNX router or interface."
      },
      "port": {
        "title": "KNX Port",
        "type": "integer",
        "default": 3671,
        "minimum": 1,
        "maximum": 65535,
        "description": "KNX UDP port."
      },
      "devices": {
        "title": "Room Monitors",
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "title": "Name",
              "type": "string",
              "minLength": 1,
              "pattern": ".*\\S.*",
              "placeholder": "Display Name for Room Monitor"
            },
            "listen_current_temperature": {
              "title": "Listen Current Temperature Address",
              "type": "string",
              "placeholder": "1/1/1",
              "pattern": "^(?:[0-9]|[12][0-9]|3[01])/(?:[0-7])/(?:[0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])$"
            }
          },
          "required": [
            "name",
            "listen_current_temperature"
          ]
        }
      }
    },
    "required": [
      "devices"
    ]
  },
  "layout": [
    {
      "key": "devices",
      "type": "array",
      "orderable": false,
      "buttonText": "Add Room Monitor",
      "items": [
        "devices[].name",
        "devices[].listen_current_temperature"
      ]
    },
    {
      "type": "section",
      "title": "Global",
      "expandable": true,
      "expanded": false,
      "items": [
        "ip",
        "port"
      ]
    }
  ]
}
