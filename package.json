{
  "displayName": "KNX Room",
  "name": "@jendrik/homebridge-knx-room",
  "version": "0.1.2",
  "description": "Homebridge plugin for KNX Room Monitors",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "config.schema.json",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git://github.com/jendrik/homebridge-knx-room.git"
  },
  "bugs": {
    "url": "https://github.com/jendrik/homebridge-knx-room/issues"
  },
  "engines": {
    "node": "^22 || ^24",
    "homebridge": "^2.0.0"
  },
  "scripts": {
    "lint": "eslint src/**/*.ts",
    "watch": "npm run build && npm link && nodemon",
    "build": "rimraf ./dist && tsc",
    "prepublishOnly": "npm run lint && npm run build"
  },
  "keywords": [
    "homebridge-plugin",
    "knx"
  ],
  "devDependencies": {
    "@eslint/js": "^8.57.1",
    "@types/node": "^22.15.0",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "eslint": "^8.57.1",
    "homebridge": "^2.0.2",
    "nodemon": "^3.1.14",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4"
  },
  "dependencies": {
    "fakegato-history": "^0.6.7",
    "knx": "^2.5.4"
  },
  "overrides": {
    "@typescript-eslint/visitor-keys": {
      "eslint-visitor-keys": "4.2.1"
    }
  }
}
